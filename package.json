{
  "name": "udocket-tooling",
  "version": "0.1.0",
  "description": "JavaScript tooling dependencies for uDocket workspace quality checks.",
  "type": "module",
  "scripts": {
    "format": "prettier --write \"{apps,packages,apps/web}/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"{apps,packages,apps/web}/**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "prettier": "3.4.2"
  }
}
